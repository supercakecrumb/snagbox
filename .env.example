# Copy this file to .env and fill in real values. Never commit .env.

# Telegram bot token, issued by @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Comma-separated Telegram user ids that bootstrap as admins
ADMIN_TG_IDS=111111111,222222222

# Postgres credentials used by the docker-compose db service
POSTGRES_USER=snagbox
POSTGRES_PASSWORD=change-me
POSTGRES_DB=snagbox

# MinIO (S3-compatible) credentials
MINIO_ROOT_USER=snagbox
MINIO_ROOT_PASSWORD=change-me

# S3 bucket used for issue attachments
S3_BUCKET=snagbox

# Public base URL snagbox uses to build bot-issued login links
PUBLIC_BASE_URL=https://snagbox.example.com

# Base64-encoded 32-byte key for encrypting session cookies.
# Generate with: openssl rand -base64 32
SESSION_ENC_KEY=change-me-base64-32-bytes

# HTTP port the service listens on
PORT=8080

# Log verbosity: debug, info, warn, error
LOG_LEVEL=info
